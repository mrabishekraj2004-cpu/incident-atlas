# Public values baked into the separate pilot frontend bundle. These are not secrets.
VITE_DATA_MODE=api
VITE_PILOT_ENABLED=true
VITE_API_BASE_URL=https://<pilot-api-host>/api/v1
VITE_OIDC_AUTHORITY=https://<identity-provider-issuer>
VITE_OIDC_CLIENT_ID=<public-browser-client-id>
VITE_OIDC_REDIRECT_URI=https://<pilot-site-host>/pilot/callback
