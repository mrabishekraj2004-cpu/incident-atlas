ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://incident_atlas:incident_atlas@localhost:5432/incident_atlas
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
LIVE_ANALYSIS_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RATE_LIMIT_HMAC_KEY=replace-this-local-development-value
RATE_LIMIT_ENABLED=true
RATE_LIVE_RUNS=5
RATE_LIVE_WINDOW_SECONDS=900
RATE_LIVE_GLOBAL_RUNS=5
RATE_LIVE_GLOBAL_WINDOW_SECONDS=86400
RATE_APPROVALS=10
RATE_APPROVAL_WINDOW_SECONDS=3600
TRUSTED_PROXY_CIDRS=
MAX_EVIDENCE_WINDOW_MINUTES=15
MAX_ROWS_PER_SIGNAL=500
MAX_REQUEST_BYTES=16384
MAX_LIVE_INFLIGHT=3
DATABASE_QUERY_TIMEOUT_SECONDS=2
MODEL_CONNECT_TIMEOUT_SECONDS=2
MODEL_READ_TIMEOUT_SECONDS=12
INVESTIGATION_DEADLINE_SECONDS=18
OTEL_EXPORTER_OTLP_ENDPOINT=
PILOT_ENABLED=true
PILOT_DEV_AUTH_ENABLED=true
PILOT_OIDC_ISSUER=
PILOT_OIDC_AUDIENCE=
PILOT_OIDC_JWKS_URL=
PILOT_RETENTION_DAYS=30
PILOT_INGEST_TOKEN_TTL_DAYS=90
PILOT_MAX_INGEST_RECORDS=500
PILOT_MAX_PAYLOAD_BYTES=65536
GITHUB_WEBHOOK_SECRETS={}
LOG_LEVEL=INFO
